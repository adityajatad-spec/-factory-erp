# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# The server connects as a least-privilege runtime role: it reads and writes rows but cannot
# change the schema, disable triggers or rewrite append-only ledgers. `pnpm db:migrate`
# creates this role on first run.
DATABASE_URL=postgres://factoryerp_app:factoryerp_app@127.0.0.1:5432/factoryerp
# Schema owner: migrations, seeding, backups and restores. Development only for the server
# (it then migrates at startup); production rejects it — run `pnpm db:migrate` separately.
DATABASE_OWNER_URL=postgres://factoryerp:factoryerp@127.0.0.1:5432/factoryerp
# Longest wait for a free pooled database connection before a request fails with 503
# (separate from per-query statement time limits).
# DATABASE_POOL_ACQUIRE_TIMEOUT_MS=10000
# Admin connection used by integration tests to create throwaway databases.
TEST_DATABASE_ADMIN_URL=postgres://factoryerp:factoryerp@127.0.0.1:5432/postgres

# Local file storage (generated PDFs, uploads). Relative paths resolve from apps/core.
DATA_DIR=./.data

# Set to true whenever the app is served over HTTPS (always in production).
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Optional: path to a Chromium/Chrome executable for PDF rendering.
# PDF_BROWSER_EXECUTABLE=/usr/bin/chromium

# Optional local AI (off by default). Ollama must already be running with the model installed;
# nothing is ever downloaded. There is no cloud provider. The ERP works the same with AI off.
# AI_PROVIDER=fake (a deterministic test double) needs NODE_ENV set explicitly to development
# or test. AI only runs for a company whose owner has set an AI policy approving the model.
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5:7b
# (Ollama "cloud" models, e.g. *-cloud, run remotely and are refused: local inference only.)
# OLLAMA_URL=http://127.0.0.1:11434
# AI_TIMEOUT_MS=120000
# AI_HEALTH_TIMEOUT_MS=2000
# AI_MODEL_CONTEXT_TOKENS=8192
# Copilot turns one person may start per window (default 20 per 600 s). Counted in each server
# process separately and reset on restart: it is not a distributed rate limiter.
# COPILOT_RATE_LIMIT_TURNS=20
# COPILOT_RATE_LIMIT_WINDOW_SECONDS=600
