{
  "name": "@factory-erp/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Factory ERP core: modular-monolith API, command/query bus, outbox worker.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.cli.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/seed/seed.cli.ts",
    "db:codegen": "tsx --env-file-if-exists=../../.env scripts/codegen.ts",
    "backup": "tsx --env-file-if-exists=../../.env src/ops/backup.cli.ts create",
    "backup:verify": "tsx --env-file-if-exists=../../.env src/ops/backup.cli.ts verify",
    "backup:restore": "tsx --env-file-if-exists=../../.env src/ops/backup.cli.ts restore"
  },
  "dependencies": {
    "@factory-erp/ai": "workspace:*",
    "@factory-erp/contracts": "workspace:*",
    "@factory-erp/gst": "workspace:*",
    "@factory-erp/money": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15"
  }
}
